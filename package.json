{
  "name": "config-manager",
  "version": "0.1.0",
  "private": true,
  "description": "NW device config generation manager with Kintone backend and Entra ID auth",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* run dev",
    "build": "pnpm --filter @config-manager/web build && pnpm --filter @config-manager/bff build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "audit:security": "node scripts/check-pnpm-audit.mjs",
    "test:audit-gate": "node --test scripts/check-pnpm-audit.test.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
