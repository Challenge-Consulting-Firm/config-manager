{
  "name": "@config-manager/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs && pnpm build:copy",
    "build:copy": "node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@config-manager/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5",
    "iron-session": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
