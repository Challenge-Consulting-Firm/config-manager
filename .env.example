# =============================================================================
# Copy this file to `.env` and fill in real values.
# All of these are also required as fly.io secrets (see README).
# =============================================================================

# ---- Server ----
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# ---- Authentication mode ----
# "oidc"      -> Entra ID (Azure AD) OpenID Connect. REQUIRED for production.
# "disabled"  -> Skip Entra ID auth and inject a fixed local user. For local
#                validation only. FORBIDDEN when NODE_ENV=production (the BFF
#                refuses to boot). When set, ENTRA_* and SESSION_SECRET below
#                are not required (any value is ignored).
AUTH_MODE=disabled
# Dummy user injected when AUTH_MODE=disabled. Recorded in Kintone audit logs.
LOCAL_DEV_USER_NAME=Local Developer
LOCAL_DEV_USER_EMAIL=local-dev@example.com
# Role for the dummy user when AUTH_MODE=disabled: viewer|operator|admin
LOCAL_DEV_USER_ROLE=admin

# ---- Entra ID (Azure AD) OIDC ----
# Only required when AUTH_MODE=oidc. Ignored when AUTH_MODE=disabled.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-your-secret-value
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional: restrict access to specific group object IDs (comma-separated).
ENTRA_REQUIRED_GROUP_IDS=
# Optional RBAC mapping (comma-separated Entra group object IDs).
# Highest match wins: admin > operator > viewer.
# When all three are empty, every authenticated user is treated as admin
# (backward compatible; set these in production to tighten privileges).
ENTRA_GROUP_ADMIN_IDS=
ENTRA_GROUP_OPERATOR_IDS=
ENTRA_GROUP_VIEWER_IDS=

# ---- Session ----
# Long random string used to seal session cookies (AUTH_MODE=oidc only).
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Kintone ----
# Your Kintone domain, e.g. example.cybozu.com
KINTONE_DOMAIN=example.cybozu.com
# API token with view/add/update permissions for the config-management app.
KINTONE_CONFIG_APP_TOKEN=your-kintone-config-app-api-token
# Numeric app id of the config-management app in Kintone.
KINTONE_CONFIG_APP_ID=1
# API token for the audit-log app.
KINTONE_AUDIT_APP_TOKEN=your-kintone-audit-app-api-token
# Numeric app id of the audit-log app.
KINTONE_AUDIT_APP_ID=2
# Optional: Meraki credentials app (for the saved-credentials feature).
# When both are blank, the Meraki 取得 page still works with manual input only.
KINTONE_MERAKI_APP_ID=
KINTONE_MERAKI_APP_TOKEN=
# Kintone admin account used ONLY by `scripts/setup-kintone.mjs` to create the
# field definitions. Not used by the running BFF. Leave blank if you create the
# fields manually in the Kintone portal.
KINTONE_ADMIN_USERNAME=
KINTONE_ADMIN_PASSWORD=

# ---- Config normalization ----
# Characters that mark a comment line in the uploaded config files.
# Defaults to "!" (Cisco-style). Comma-separated list. Example: "!,#"
CONFIG_COMMENT_PREFIXES=!

# ---- Meraki Dashboard API (optional) ----
# API key issued at https://dashboard.meraki.com -> Organization > Settings > API.
# Required only when using the Meraki import feature. If left blank, the user
# must enter the API key on the Meraki 取得 page each time.
MERAKI_API_KEY=
# Base URL of the Meraki API. Default is the global region; China mainland
# uses a different host. Override only when your dashboard is not on
# api.meraki.com.
MERAKI_API_BASE=https://api.meraki.com/api/v1
# Per-request timeout (ms) and max retries on HTTP 429.
MERAKI_TIMEOUT_MS=30000
MERAKI_MAX_RETRIES=3
# Max number of section endpoints fetched in parallel. Lower this if you keep
# hitting Meraki rate limits (429); the default 5 stays well under the ~10
# requests/second per-organization limit.
MERAKI_SECTION_CONCURRENCY=5
